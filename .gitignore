# Build output
[Bb]in/
[Oo]bj/
out/
artifacts/

# C# source folders named "Artifacts" hold source, not build output — keep them tracked.
!WIP/Wip.Abstractions/Artifacts/
!WIP/Wip.Artifacts.Local/Artifacts/
!WIP/Wip.Artifacts.Local.Tests/Artifacts/

# User-specific files
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Visual Studio / VS Code
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Test results and coverage
TestResults/
*.trx

# Execution evidence TRX files are contractual artifacts
!docs/execution/evidence/**/*.trx

# Test console logs and hang attachments stay on disk; TRX is the committed evidence
docs/execution/evidence/**/test-results/*.out.txt
docs/execution/evidence/**/test-results/*/*.xml
*.coverage
*.coveragexml
coverage/

# NuGet
*.nupkg
*.snupkg
packages/

# Logs
*.log

# Execution evidence logs are contractual artifacts (red.log, verify.log)
!docs/execution/**/*.log

# Local scratch and generated runtime state (kept on disk, not committed)
.tmp/
host-stdout.txt
host-stderr.txt
test_status_simple.cs
tmp-facing-repro.csx
WIP/_*.csx
WIP/BonesLibraryRecovery/debug.csx
tools/_write_bones_e2e_files.py
WIP/Wip.Bones.Host/bones-data/.bones/pool/

# Local WIP shell runtime state
.wip/

# Rider
.idea/

# OS files
.DS_Store
Thumbs.db
