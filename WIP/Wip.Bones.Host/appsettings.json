{
  "BonesHost": {
    "DataDirectory": "bones-data",
    "ListenUrl": "http://127.0.0.1:8080",
    "IterationDelayMs": 0,
    "MaxGamesPerRun": 200,
    "AllowUnbounded": false,
    "MaxConsecutiveIterationFailures": 3,
    "FailureBackoffBaseMs": 1000,
    "FailureBackoffMaxMs": 60000,
    "ParallelSessionCount": 1,
    "AllSeatsLearning": true,
    "ResumeFromBest": true,
    "ModelProvider": "deepseek",
    "EvaluationTargetScore": 12,

    "DeepSeek": {
      "BaseUrl": "https://api.deepseek.com",
      "Model": "deepseek-flash",
      "TimeoutSeconds": 120,
      "ApiKeySource": "env:DEEPSEEK_API_KEY",
      "Temperature": 0.8,
      "Thinking": "disabled"
    },

    "DefaultParameters": {
      "GameCount": 1,
      "Seed": 4242,
      "TargetScore": 20,
      "LearningPlayerId": 1
    },

    "Ponder": {
      "MaxCompileRetries": 5
    },

    "Promotion": {
      "EvaluationMatchCount": 8,
      "MaxConcurrentMatches": 4,
      "MinimumWinRateImprovement": 0.02,
      "MinimumScoreDifferentialImprovement": 1,
      "MinimumCrossSeatCount": 1,
      "GateMode": "ConfidenceComposite",
      "UsePairedEvaluationSeeds": true,
      "ConfidenceZThreshold": 1.0,
      "WinRateHardFloor": -0.1,
      "ScoreDifferentialHardFloor": -2.0
    },

    "ScriptHost": {
      "CompilationTimeout": "00:00:30",
      "ExecutionTimeout": "00:00:05",
      "MaxCompiledScripts": 512,
      "EnableDirectExecutionTimeout": true,
      "Mode": "InProcess",
      "TrustedOnly": true
    },

    "AggressiveIteration": {
      "GameCountMultiplier": 2.0,
      "TargetScoreMultiplier": 1.5,
      "ExplorationTemperature": 0.9,
      "EnableCrossSeatTesting": true,
      "EnableSeatRotation": true,
      "ConcurrentGamesPerSession": 2,
      "EnhanceIterationsPerMatch": 1,
      "MinimumDistinctStrategiesPerSeat": 5,
      "RequireDistinctOutput": true,
      "DistinctOutputMaxRetries": 2,
      "CrossSeatRotation": true,
      "OpponentSourceExcerptMaxLength": 8000,
      "PerSessionBudget": true
    },

    "Resilience": {
      "MaxRetries": 5,
      "ExponentialBackoffBaseMs": 200,
      "CircuitBreakThreshold": 12,
      "CircuitBreakDurationSeconds": 60,
      "MaxConcurrentCalls": 32,
      "MaxQueueDepth": 64,
      "PreemptiveThrottleThreshold": 16
    },

    "Population": {
      "PoolSize": 100,
      "MaxPopulation": 200
    }
  }
}
