<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Dedicated continuous Bones learning host with integrated match viewer.</Description>
    <PackageId>Wip.Bones.Host</PackageId>
    <DisableStaticWebAssetProjectReference>true</DisableStaticWebAssetProjectReference>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Wip.Bones.Host.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Wip.Bones.Web\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wip.Abstractions\Wip.Abstractions.csproj" />
    <ProjectReference Include="..\Wip.Agent.Basic\Wip.Agent.Basic.csproj" />
    <ProjectReference Include="..\Wip.Artifacts.Local\Wip.Artifacts.Local.csproj" />
    <ProjectReference Include="..\Wip.Bones.Agents\Wip.Bones.Agents.csproj" />
    <ProjectReference Include="..\Wip.Bones.Web\Wip.Bones.Web.csproj" />
    <ProjectReference Include="..\Wip.Bones\Wip.Bones.csproj" />
    <ProjectReference Include="..\Wip.Bones.ModelProviders.DeepSeek\Wip.Bones.ModelProviders.DeepSeek.csproj" />
    <ProjectReference Include="..\Wip.Builder\Wip.Builder.csproj" />
    <ProjectReference Include="..\Wip.Runtime\Wip.Runtime.csproj" />
  </ItemGroup>
</Project>