<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Read-only ASP.NET Core spectator viewer for the WIP Tholdem heads-up Hold'em domain.</Description>
    <PackageId>Wip.Tholdem.Web</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the static viewer next to the assembly so an in-process host can find it. -->
    <Content Update="wwwroot\viewer\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wip.Tholdem\Wip.Tholdem.csproj" />
    <ProjectReference Include="..\Wip.Tholdem.Agents\Wip.Tholdem.Agents.csproj" />
  </ItemGroup>
</Project>